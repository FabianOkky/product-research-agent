# =====================================================================
# Production environment template — copy to .env on your server, then fill in.
# NEVER commit the real .env (it holds secrets). Generate APP_KEY with:
#   php artisan key:generate
# =====================================================================

APP_NAME="Product Research Agent"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database: Supabase PostgreSQL -----------------------------------
# Web app may use the Supabase connection pooler (port 6543).
# Run migrations against the direct/session pooler (port 5432).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

# --- Sessions / cache / queue ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# The pipeline runs as a queued job — a worker (php artisan queue:work)
# MUST be running in production or research jobs will never process.
QUEUE_CONNECTION=database
# Must stay greater than the job timeout (120s) to avoid double execution.
DB_QUEUE_RETRY_AFTER=180

# --- Mail (only needed if you enable email verification) --------------
MAIL_MAILER=log

# ===== Product Research Agent ========================================
AI_TEXT_PROVIDER=gemini
GEMINI_API_KEY=
SERPER_API_KEY=
JINA_READER_URL=https://r.jina.ai
RESEARCH_QUERIES=3
RESEARCH_URLS_PER_QUERY=2
RESEARCH_HTTP_TIMEOUT=20
RESEARCH_AI_MODEL=gemini-2.5-flash

# --- AI failover (Phase 9/10): optional backup chain when the primary hits
# its rate limit / quota. Comma-separate to chain multiple providers in order.
# Leave the fallback empty to disable. Production tip: Groq (free cloud) is the
# best 24/7 backup; Ollama is local-only (dev machines, not cheap hosting).
# Structured param extraction auto-skips Groq (strict json_schema) -> Gemini/Ollama.
#   RESEARCH_AI_FALLBACK_PROVIDER=groq
#   RESEARCH_AI_FALLBACK_MODEL=llama-3.3-70b-versatile
RESEARCH_AI_PRIMARY_PROVIDER=gemini
RESEARCH_AI_FALLBACK_PROVIDER=
RESEARCH_AI_FALLBACK_MODEL=
# GROQ_API_KEY=
